# ============================================================
# Blitz TokyoInsider Scraper API — Environment Variables
# Author: Blitz (@blitzlabx)
# ============================================================

# Primary site to scrape
# TI_BASE_URL=https://www.tokyoinsider.net

# Browser fingerprint for curl_cffi (chrome120, chrome124, etc.)
# TI_IMPERSONATE=chrome124

# Optional HTTP/HTTPS proxy
# TI_PROXY=http://user:pass@host:port

# FlareSolverr instance for Cloudflare challenges (highly recommended)
# TI_FLARESOLVERR_URL=http://localhost:8191

# Minimum delay between upstream requests (seconds)
# TI_MIN_INTERVAL=0.35

# Cache TTLs (seconds)
# TI_CACHE_TTL=300
# TI_CATALOG_TTL=21600
# TI_SEARCH_TTL=60
